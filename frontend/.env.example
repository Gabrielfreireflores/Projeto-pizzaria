# URL do backend Flask (padrão: http://127.0.0.1:5000)
BACKEND_URL=http://127.0.0.1:5000
# Na Vercel, defina BACKEND_URL=https://seu-backend.example antes do build.
# Variável somente do servidor; não use NEXT_PUBLIC_ nem coloque segredos aqui.
# Host público exato do store (ex.: seu-store.public.blob.vercel-storage.com).
# Não é token: nunca colocar BLOB_READ_WRITE_TOKEN no frontend.
NEXT_PUBLIC_BLOB_HOST=
