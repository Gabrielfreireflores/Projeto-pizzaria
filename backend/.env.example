DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/pizzaria
DB_CONNECT_TIMEOUT=10
# Neon: URL pooled para a aplicação, TLS sslmode=require&channel_binding=require.
# URL direta somente para manutenção futura; não executar migrations na aplicação.
SECRET_KEY=
# Gere uma chave aleatória uma vez; não regenere a cada inicialização.
# Em produção: mínimo 32 caracteres, armazenada apenas no ambiente do backend.
APP_ENV=development
PORT=5000
# Origens exatas, sem caminho, separadas por vírgula. Produção exige HTTPS.
APP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# local apenas em desenvolvimento; disabled em produção até definir serviço externo.
IMAGE_STORAGE=local
# Em produção: APP_ENV=production, IMAGE_STORAGE=disabled,
# DATABASE_URL do PostgreSQL hospedado com TLS conforme exigido pelo provedor,
# APP_ORIGINS=https://seu-frontend.example (também previews autorizados explicitamente).
# VERCEL=1 também ativa automaticamente as restrições de produção.
# Histórico da Etapa 1: sem credenciais ou adaptador externo; a Etapa 2 usa Blob.
# Etapa 2 (demonstração acadêmica): IMAGE_STORAGE=blob, store público para fotos do cardápio.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# Local sem dependência externa; em produção usar upstash (disabled bloqueia login).
LOGIN_RATE_LIMITER=disabled
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LOGIN_RATE_LIMIT=10
LOGIN_GLOBAL_LIMIT=100
LOGIN_WINDOW_SECONDS=900
